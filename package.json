{
  "name": "mintblog",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "license": "MIT",
  "scripts": {
    "astro": "astro",
    "sync": "astro sync",
    "dev": "astro dev",
    "check": "astro check",
    "content:dates": "node --experimental-strip-types scripts/export-post-dates.ts",
    "prebuild": "pnpm content:dates",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown --cache",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 --cache",
    "lint:fix": "eslint . --fix --cache",
    "toolbar:on": "astro preferences enable devToolbar",
    "toolbar:off": "astro preferences disable devToolbar",
    "prepare": "simple-git-hooks",
    "postbuild": "node scripts/build-search.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@iconify/json": "^2.2.553",
    "@types/node": "^24.19.2",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/parser": "^8.72.1",
    "@unocss/astro": "^66.12.0",
    "@unocss/reset": "^66.12.0",
    "astro": "^7.4.7",
    "astro-expressive-code": "^0.44.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "html-entities": "^2.6.0",
    "katex": "0.18.10",
    "lint-staged": "^17.6.0",
    "mdast-util-to-string": "^4.0.0",
    "nprogress": "^0.2.0",
    "p5": "^2.4.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-callouts": "^2.2.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-wrap-all": "^1.1.0",
    "remark-directive": "^4.0.0",
    "remark-directive-sugar": "^2.0.1",
    "remark-imgattr": "^1.1.1",
    "remark-math": "^6.0.0",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.5",
    "simple-git-hooks": "2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unist-util-visit": "^5.2.0",
    "unocss": "^66.12.0",
    "viewerjs": "^1.15.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts,astro}": [
      "eslint --report-unused-disable-directives --max-warnings 0"
    ]
  },
  "pnpm": {
    "overrides": {
      "katex@<0.18.2": "0.18.10",
      "minimatch@<11.0.1": "11.0.1",
      "satori>fflate": "0.7.5",
      "@astrojs/rss>fast-xml-parser": "5.12.0",
      "@napi-rs/wasm-runtime@1.2.4>@emnapi/runtime": "1.11.3"
    }
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
