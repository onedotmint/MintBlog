---
import RenderProject from '~/components/views/RenderProject.astro'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('projectPosts', ({ data }) => !data.draft)

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
---

<RenderProject {post} />
