---
interface Props {
  variant?: 'base' | 'plus'
}

const { variant = 'base' } = Astro.props

const logger = {
  info(message: string) {
    if (import.meta.env.DEV) console.info(`[signal] ${message}`)
  },
}

/*
 * ======================================================================
 * 步骤1：选择背景变体
 * ======================================================================
 * 目标：让现有 signal 背景和扩展版共用同一套 SVG 结构。
 * 数据源：Background.astro 传入的 variant 属性。
 * 操作：
 * 1) 默认渲染原有 signal 背景。
 * 2) 只有 plus 变体渲染额外的低对比装饰层。
 */
logger.info('步骤1开始：选择背景变体')
const isPlus = variant === 'plus'
logger.info(`步骤1结束：选择背景变体 ${variant}`)
---

<div
  class:list={[
    'signal-background z--1 fixed inset-0 pointer-events-none print:hidden',
    isPlus && 'signal-background--plus',
  ]}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 1440 900"
    preserveAspectRatio="none"
    focusable="false"
    role="presentation"
  >
    <g class="signal-traces">
      <path
        class="signal-trace signal-trace--one"
        d="M-120 170C150 30 290 290 540 165S900 90 1160 205 1415 300 1560 150"
      />
      <path
        class="signal-trace signal-trace--two"
        d="M-160 410C90 280 270 485 510 360S870 250 1115 390 1390 480 1580 330"
      />
      <path
        class="signal-trace signal-trace--three"
        d="M-140 700C130 560 315 760 575 630S940 540 1180 680 1410 760 1570 610"
      />
      <path
        class="signal-trace signal-trace--four"
        d="M180-80C320 100 220 250 410 380S760 530 720 740 820 930 980 1020"
      />
      <path
        class="signal-trace signal-trace--five"
        d="M1160-80C1050 110 1200 230 1035 390S760 540 850 735 1080 900 1270 1010"
      />
    </g>
    <g class="signal-nodes">
      <circle class="signal-node signal-node--one" cx="340" cy="238" r="2.4" />
      <circle class="signal-node signal-node--two" cx="760" cy="352" r="1.8" />
      <circle class="signal-node signal-node--three" cx="1130" cy="205" r="2.2" />
      <circle class="signal-node signal-node--four" cx="470" cy="648" r="1.8" />
      <circle class="signal-node signal-node--five" cx="1010" cy="665" r="2.4" />
    </g>
    <!--
      /*
       * ==================================================================
       * 步骤2：增加低密度回声层
       * ==================================================================
       * 目标：让首页比原有 signal 多一点动态细节，但不改变主轮廓。
       * 数据源：三条偏移路径和三个几何标记。
       * 操作：
       * 1) 用稀疏短划线补充空间层次。
       * 2) 用低频透明度变化增加轻微动态。
       */
    -->
    {
      isPlus && (
        <>
          <g class="signal-plus-echoes">
            <path
              class="signal-plus-echo signal-plus-echo--one"
              d="M-100 300C100 210 300 390 520 285S910 210 1160 320 1400 370 1540 270"
            />
            <path
              class="signal-plus-echo signal-plus-echo--two"
              d="M-120 560C120 450 320 640 560 540S900 460 1180 580 1420 620 1570 510"
            />
            <path
              class="signal-plus-echo signal-plus-echo--three"
              d="M300-90C460 80 420 260 620 360S900 520 1060 700 1200 850 1460 930"
            />
          </g>
          <g class="signal-plus-markers">
            <path
              class="signal-plus-marker signal-plus-marker--one"
              d="M198 120h24M210 108v24"
            />
            <path
              class="signal-plus-marker signal-plus-marker--two"
              d="M908 470h24M920 458v24"
            />
            <path
              class="signal-plus-marker signal-plus-marker--three"
              d="M1248 730h24M1260 718v24"
            />
          </g>
        </>
      )
    }
  </svg>
</div>

<style>
  /*
   * ======================================================================
   * 步骤1：绘制 Contour Signal 背景
   * ======================================================================
   * 目标：提供不干扰内容阅读的低对比背景。
   * 数据源：固定 SVG 路径和少量薄荷色信号点。
   * 操作：
   * 1) 用银灰流线构成静态轮廓。
   * 2) 只在允许动画时改变线段和信号点的显示位置。
   */
  .signal-background {
    color: #68716d;
    opacity: 0.34;
    contain: strict;
  }

  /*
   * ======================================================================
   * 步骤4：保护浅色主题文字对比度
   * ======================================================================
   * 目标：让首页扩展背景保留细节，同时不让浅色正文被背景纹理干扰。
   * 数据源：signal-plus 变体和浅色主题状态。
   * 操作：
   * 1) 只降低扩展变体在浅色主题下的整体透明度。
   * 2) 保持基础 signal 页面和深色主题的原有表现。
  */
  :global(html:not(.dark)) .signal-background.signal-background--plus {
    opacity: 0.1;
  }

  /*
   * ======================================================================
   * 步骤5：降低深色主题背景干扰
   * ======================================================================
   * 目标：让首页扩展背景保留轮廓，同时避免线条削弱正文识别度。
   * 数据源：signal-plus 变体和深色主题状态。
   * 操作：
   * 1) 降低扩展变体在深色主题下的整体透明度。
   * 2) 保持基础 signal 页面使用原有透明度。
   */
  :global(html.dark) .signal-background.signal-background--plus {
    opacity: 0.12;
  }

  .signal-background svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .signal-trace {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.25;
    stroke-dasharray: 280 90;
    vector-effect: non-scaling-stroke;
  }

  .signal-trace--one {
    opacity: 0.75;
  }

  .signal-trace--two {
    opacity: 0.48;
    stroke-dasharray: 210 130;
  }

  .signal-trace--three {
    opacity: 0.58;
    stroke-dasharray: 340 120;
  }

  .signal-trace--four,
  .signal-trace--five {
    opacity: 0.35;
    stroke-width: 0.9;
    stroke-dasharray: 180 140;
  }

  /*
   * ======================================================================
   * 步骤3：配置扩展层样式
   * ======================================================================
   * 目标：保持新增元素比主流线更轻，避免影响正文阅读。
   * 数据源：signal-plus-echoes 和 signal-plus-markers SVG 分组。
   * 操作：
   * 1) 用更细的线宽和更低的不透明度表达次级层。
   * 2) 复用 currentColor，确保明暗主题保持黑白方向。
   */
  .signal-plus-echo {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 0.7;
    stroke-dasharray: 8 64;
    opacity: 0.18;
    vector-effect: non-scaling-stroke;
  }

  .signal-plus-echo--one {
    opacity: 0.24;
  }

  .signal-plus-echo--two {
    opacity: 0.15;
  }

  .signal-plus-echo--three {
    opacity: 0.12;
  }

  .signal-plus-marker {
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-width: 0.8;
    opacity: 0.2;
    vector-effect: non-scaling-stroke;
  }

  .signal-plus-marker--two {
    opacity: 0.14;
  }

  .signal-plus-marker--three {
    stroke-width: 1;
    opacity: 0.16;
  }

  .signal-node {
    fill: #78c9b0;
    opacity: 0.62;
  }

  .signal-node--two,
  .signal-node--four {
    opacity: 0.42;
  }

  :global(html.dark) .signal-background {
    color: #bdc6c3;
    opacity: 0.3;
  }

  @media (prefers-reduced-motion: no-preference) {
    .signal-trace {
      animation: signal-flow 42s linear infinite;
    }

    .signal-trace--two {
      animation-duration: 52s;
      animation-direction: reverse;
    }

    .signal-trace--three {
      animation-duration: 64s;
    }

    .signal-trace--four,
    .signal-trace--five {
      animation-duration: 58s;
    }

    .signal-node {
      animation: signal-pulse 8s ease-in-out infinite;
    }

    .signal-node--two {
      animation-delay: -2.5s;
    }

    .signal-node--three {
      animation-delay: -5s;
    }

    .signal-node--four {
      animation-delay: -1.5s;
    }

    .signal-node--five {
      animation-delay: -6s;
    }

    .signal-plus-echo {
      animation: signal-plus-flow 72s linear infinite;
    }

    .signal-plus-echo--two {
      animation-duration: 86s;
      animation-direction: reverse;
    }

    .signal-plus-echo--three {
      animation-duration: 98s;
    }

    .signal-plus-marker {
      animation: signal-plus-pulse 11s ease-in-out infinite;
    }

    .signal-plus-marker--two {
      animation-delay: -3.5s;
    }

    .signal-plus-marker--three {
      animation-delay: -7s;
    }
  }

  @keyframes signal-flow {
    from {
      stroke-dashoffset: 0;
    }

    to {
      stroke-dashoffset: -740;
    }
  }

  @keyframes signal-pulse {
    0%,
    100% {
      opacity: 0.34;
    }

    50% {
      opacity: 0.78;
    }
  }

  @keyframes signal-plus-flow {
    from {
      stroke-dashoffset: 0;
    }

    to {
      stroke-dashoffset: -320;
    }
  }

  @keyframes signal-plus-pulse {
    0%,
    100% {
      opacity: 0.1;
    }

    50% {
      opacity: 0.32;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-trace,
    .signal-node,
    .signal-plus-echo,
    .signal-plus-marker {
      animation: none;
    }
  }

  @media (max-width: 639px) {
    .signal-background {
      opacity: 0.28;
    }

    :global(html:not(.dark)) .signal-background.signal-background--plus {
      opacity: 0.07;
    }

    :global(html.dark) .signal-background.signal-background--plus {
      opacity: 0.09;
    }

    :global(html.dark) .signal-background {
      opacity: 0.22;
    }

    .signal-plus-echo {
      opacity: 0.12;
    }

    .signal-plus-marker {
      opacity: 0.13;
    }
  }
</style>
