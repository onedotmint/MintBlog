---
import Plum from '~/components/backgrounds/Plum.astro'
import Dot from '~/components/backgrounds/Dot.astro'
import Rose from '~/components/backgrounds/Rose.astro'
import Particle from '~/components/backgrounds/Particle.astro'
import Signal from '~/components/backgrounds/Signal.astro'
import Atmosphere from '~/components/backgrounds/Atmosphere.astro'

import type { BgType } from '~/types'

interface Props {
  type: BgType
}

const { type } = Astro.props
---

{type === 'plum' && <Plum />}
{type === 'dot' && <Dot />}
{type === 'rose' && <Rose />}
{type === 'particle' && <Particle />}
{(type === 'breeze' || type === 'mist') && <Atmosphere variant={type} />}
{
  (type === 'signal' || type === 'signal-plus') && (
    <Signal variant={type === 'signal-plus' ? 'plus' : 'base'} />
  )
}
