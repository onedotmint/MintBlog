---
import { getCollection } from 'astro:content'

import Warning from '~/components/base/Warning.astro'
import DesktopAside from '~/components/base/DesktopAside.astro'
import MobileControl from '~/components/base/MobileControl.astro'
import Categorizer from '~/components/base/Categorizer.astro'
import GroupItem from '~/components/views/GroupItem.astro'
import { FEATURES } from '~/config'
import { withBasePath } from '~/utils/path'

import type { GroupItemData } from '~/components/views/GroupItem.astro'

interface Props {
  pageToc?: boolean
  showCategories?: boolean
}

const { pageToc = false, showCategories = true } = Astro.props

const WARNING = `No content available for display.
  Please review and modify <code>GroupView.astro</code> as needed.`

const projects = await getCollection('projectPosts', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
)
projects.sort(
  (a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
    a.id.localeCompare(b.id),
)

const data = new Map<string, GroupItemData[]>()
for (const post of projects) {
  const items = data.get(post.data.category) ?? []
  items.push({
    title: post.data.title + (post.data.draft ? '（草稿）' : ''),
    href: withBasePath(`/projects/${post.id}/`),
    desc: post.data.description,
    icon: post.data.icon,
  })
  data.set(post.data.category, items)
}
const isEmpty = projects.length === 0

/* Toc */
const { toc } = FEATURES
const tocEnabled = Array.isArray(toc) && toc[0] && pageToc
---

{isEmpty ? (
  <Warning html={WARNING} />
) : (
  <>
    {tocEnabled && (
      <>
        <DesktopAside
          anchors={[...data.keys()]}
          style={
            toc[1].displayPosition === 'right'
              ? 'left: calc(100vw - 15.625rem + 5rem)'
              : undefined
          }
        />
        <MobileControl anchors={[...data.keys()]} />
      </>
    )}
    {[...data].map(([key, items], idx) => (
      <div class="slide-enter" style={{ '--enter-stage': idx }}>
        {showCategories && (
          <Categorizer text={key} needId={tocEnabled} wide={true} />
        )}
        <GroupItem {items} />
      </div>
    ))}
  </>
)}
