---
import CardItem from '~/components/views/CardItem.astro'
import Warning from '~/components/base/Warning.astro'
import DesktopAside from '~/components/base/DesktopAside.astro'
import MobileControl from '~/components/base/MobileControl.astro'

import {
  getFilteredPosts,
  sortPostsByField,
} from '~/utils/data'
import { withBasePath } from '~/utils/path'
import { FEATURES } from '~/config'

import type { CollectionKey } from 'astro:content'
import type { CardItemData } from '~/components/views/CardItem.astro'

interface Props {
  collectionType: CollectionKey
  gap?: number
  minCardWidth?: number
  maxCardWidth?: number
  pageTag?: boolean
}

const {
  collectionType,
  gap = 16,
  minCardWidth,
  maxCardWidth,
  pageTag = false,
} = Astro.props

const WARNING = `No content available for display.
  Please review and modify <code>CardView.astro</code> as needed.`

let isEmpty = false
let dataForGrid: CardItemData[] = []

/* Tag */
const { tag } = FEATURES
const tagEnabled = Array.isArray(tag) && tag[0] && pageTag
let tags: string[][] = []
let haveTags = false

/* /shorts */
if (collectionType === 'shorts') {
  const items = await getFilteredPosts(collectionType)
  const sorted = sortPostsByField(items, 'title')
  dataForGrid = sorted.map((item) => ({
    link: item.data.redirect || withBasePath(`/${collectionType}/${item.id}/`),
    text: item.data.title,
    date: item.data.pubDate,
    tags: item.data.tags,
  }))

  if (tagEnabled) {
    for (const item of sorted) {
      const tag = item.data.tags
      if (tag.length === 0) continue
      tags.push(tag)
    }
  }

  haveTags = tagEnabled && tags.length > 0
}

if (dataForGrid.length === 0) isEmpty = true
---

{
  isEmpty ? (
    <Warning html={WARNING} />
  ) : (
    <>
      {!haveTags && (
        <div
          class="grid auto-rows-[minmax(12.5rem,1fr)] mx-20 lt-md:mx-1 fade-in"
          style={{
            '--fade-in-duration': '0.6s',
            'gap': `${gap}px`,
            'grid-template-columns': `repeat(auto-fill, minmax(${minCardWidth ? `${minCardWidth}px` : '220px'}, ${maxCardWidth ? `${maxCardWidth}px` : '1fr'}))`,
          }}
        >
          {dataForGrid.map((item) => (
            <CardItem
              class="min-h-40 lt-md:min-h-0
                [&>*:first-child]:rounded-xl [&:hover>*:first-child]:(shadow-custom_0_0_15_-3 scale-103 transition-transform)"
              item={item}
            />
          ))}
        </div>
      )}
      {haveTags && (
        <>
          <div
            class="grid items-start gap-8 grid-cols-[minmax(0,1fr)_15.625rem] lt-lgp:(grid-cols-1)
              mx-20 lt-lgp:mx-10 lt-md:mx-1 fade-in"
          >
            <div
              class="grid items-stretch auto-rows-[minmax(12.5rem,1fr)]"
              style={{
                '--fade-in-duration': '0.6s',
                'gap': `${gap}px`,
                'grid-template-columns': `repeat(auto-fill, minmax(${minCardWidth ? `${minCardWidth}px` : '180px'}, ${maxCardWidth ? `${maxCardWidth}px` : '1fr'}))`,
              }}
            >
              {dataForGrid.map((item) => (
                <CardItem
                  class="[&>*:first-child]:rounded-xl [&:hover>*:first-child]:(shadow-custom_0_0_15_-3 scale-103 transition-transform)"
                  item={item}
                />
              ))}
            </div>
            {tagEnabled && tags.length > 0 && (
              <DesktopAside
                tags={tags}
                style="position: sticky"
                tagStyle="max-height: 54vh; opacity: 0.6"
                tagButtonText="Choose Tags"
              />
            )}
          </div>
          {/* Move out of the fade-in element to avoid layering issues causing the panel to be below the backdrop */}
          {tagEnabled && tags.length > 0 && <MobileControl tags={tags} />}
        </>
      )}
    </>
  )
}
