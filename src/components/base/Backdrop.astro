---
---

<div
  id="backdrop"
  class="hidden z-150 fixed inset-0 bg-[#ffffffcc] dark:bg-[#000000cc]"
  aria-hidden="true"
></div>

<script>
  import {
    finishPendingFadeEffects,
    toggleFadeEffect,
    unlockScroll,
  } from '~/utils/misc'

  const PANELS = [
    { id: 'nav-panel', hiddenClass: 'hidden!' },
    { id: 'toc-panel', hiddenClass: 'hidden!' },
    { id: 'tag-panel', hiddenClass: 'hidden!' },
    { id: 'search-panel', hiddenClass: 'hidden' },
  ]

  const getOpenPanel = () => {
    for (const { id, hiddenClass } of PANELS) {
      const panel = document.getElementById(id)
      if (panel && !panel.inert && !panel.classList.contains(hiddenClass)) {
        return { panel, hiddenClass }
      }
    }
    return null
  }

  const closePanel = () => {
    const open = getOpenPanel()
    if (!open) return
    toggleFadeEffect(open.panel.id, false, open.hiddenClass)
    toggleFadeEffect('backdrop', false, 'hidden')
  }

  document.addEventListener('astro:page-load', () => {
    document.getElementById('backdrop')?.addEventListener('click', closePanel)
    document
      .querySelectorAll<HTMLButtonElement>('[data-panel-close]')
      .forEach((button) => {
        button.addEventListener('click', closePanel)
      })
  })

  document.addEventListener('keydown', (event) => {
    if (event.isComposing || (event.key !== 'Tab' && event.key !== 'Escape'))
      return
    const open = getOpenPanel()
    if (!open) return

    if (event.key === 'Escape') {
      event.preventDefault()
      closePanel()
      return
    }

    const { panel } = open
    const focusable = Array.from(
      panel.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])',
      ),
    ).filter(
      (element) => element.tabIndex >= 0 && element.getClientRects().length > 0,
    )
    const first = focusable[0]
    const last = focusable.at(-1)
    const active = document.activeElement
    const outside = !panel.contains(active) || active === panel

    if (!first || !last) {
      event.preventDefault()
      panel.focus()
    } else if (event.shiftKey && (active === first || outside)) {
      event.preventDefault()
      last.focus()
    } else if (!event.shiftKey && (active === last || outside)) {
      event.preventDefault()
      first.focus()
    }
  })

  document.addEventListener('astro:before-swap', () => {
    finishPendingFadeEffects()
    unlockScroll()
  })
</script>
