---
import { FEATURES } from '~/config'
import { withBasePath } from '~/utils/path'
import { parseTuple, getFilteredPosts } from '~/utils/data'

const { search } = FEATURES
if (!search || (Array.isArray(search) && !search[0])) return

const { includes, filter, navHighlight, batchLoadSize, maxItemsPerPage } =
  search[1]
if (includes.length === 0)
  throw new Error(
    "Search feature enabled, but `includes` array is empty. Please check 'src/config.ts' for the correct configuration."
  )
const categories = includes.map((type) => ({
  type,
  label: type === 'shorts' ? 'Collections' : type.charAt(0).toUpperCase() + type.slice(1),
}))
const filterEnabled = filter && includes.length > 1
const batchSize = parseTuple(batchLoadSize, 'batchLoadSize')
const maxItems = parseTuple(maxItemsPerPage, 'maxItemsPerPage')
const searchableGroups = await Promise.all(
  (['blog', 'shorts'] as const)
    .filter((collection) => includes.includes(collection))
    .map((collection) => getFilteredPosts(collection))
)
const hasSearchablePosts = searchableGroups.some((posts) =>
  posts.some(({ data }) => !data.draft && data.search)
)
---

<!-- Search Switch -->
<button
  type="button"
  id="search-switch"
  aria-controls="search-panel"
  aria-expanded="false"
  class="op-60 hover:op-100 op-transition"
  title="Search"
  aria-label="Search"
>
  <div u-i-grommet-icons-search></div>
</button>

<!-- Search Panel -->
<search-panel
  role="dialog"
  id="search-panel"
  tabindex="-1"
  data-panel-trigger="search-switch"
  class={`hidden z-200 fixed top-15% lt-lgp:(top-10%) left-50% translate-x--50%
    grid grid-rows-[auto_1fr_auto]
    w-42rem lt-lgp:(w-90%) max-h-70vh lt-lgp:(max-h-80vh) p-3 lt-lgp:(pb-1) rounded-lg
    text-[var(--c-text)] bg-[var(--c-bg)] shadow-custom_0_0_10_0`}
  aria-modal="true"
  aria-labelledby="search-label"
  aria-keyshortcuts="ArrowUp,ArrowDown,Enter,Esc"
  data-production={import.meta.env.PROD}
  data-empty-index={!hasSearchablePosts}
  data-pagefind-url={withBasePath('/pagefind/pagefind.js')}
  data-nav-highlight={navHighlight}
  data-filter={filterEnabled}
  data-batch-size={batchSize}
  data-max-items={maxItems}
>
  <div class="flex flex-col gap-2">
    <!-- Tab list -->
    {
      filterEnabled && (
        <div
          role="tablist"
          class="search-tabs flex gap-2 justify-start items-center text-xs"
          aria-label="Search categories"
        >
          {categories.map(({ type, label }, idx) => (
            <button
              type="button"
              role="tab"
              id={`search-tab-${type}`}
              aria-controls="search-results"
              aria-selected={idx === 0 ? 'true' : 'false'}
              tabindex={idx === 0 ? 0 : -1}
              class="px-1.5 py-0.5 rounded
                bg-[#88888816] dark:bg-[#88888823]
                aria-[selected=false]:op-40 aria-[selected=true]:op-100
                aria-[selected=false]:hover:op-70 op-transition cursor-pointer"
              data-type={type}
              data-label={label}
            >
              {label}
            </button>
          ))}
        </div>
      )
    }
    <!-- Search Bar -->
    <div
      class="grid grid-cols-[auto_1fr_auto] items-center
        h-10 px-3 rounded-md
        bg-[#88888811] dark:bg-[#88888818]"
    >
      <div u-i-grommet-icons-search></div>
      <label for="search-input" id="search-label" class="sr-only"></label>
      <input
        type="search"
        role="combobox"
        id="search-input"
        data-panel-autofocus
        class="min-w-0 w-full h-full pl-2 bg-transparent outline-0"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        aria-labelledby="search-label"
        aria-autocomplete="list"
        aria-controls="search-content"
        aria-expanded="false"
      />
      <button
        type="button"
        data-panel-close
        aria-label="Close search"
        class="flex items-center justify-center size-8 op-60 hover:op-100 op-transition"
      >
        <span class="i-ri-close-line" aria-hidden="true" />
      </button>
    </div>
  </div>
  <!-- Search Results -->
  <div
    role={filterEnabled ? 'tabpanel' : undefined}
    id="search-results"
    class="overflow-y-auto my-1"
    aria-labelledby={filterEnabled ? `search-tab-${includes[0]}` : undefined}
    data-base={withBasePath('/')}
  >
    <!-- Results -->
    <div id="search-content" role="listbox" aria-label="Search results"></div>
    <!-- Feedback -->
    <div id="search-feedback" role="status" aria-atomic="true" class="hidden py-3 text-center text-sm op-40">
    </div>
    <!-- Pagination -->
    <div
      id="search-pagination"
      style="display: none"
      class="items-center justify-center gap-4 pt-4 pb-3 text-xs"
    >
      <button
        class="flex items-center justify-center gap-1 op-40 hover:op-100 op-transition"
        data-action="more"
      >
        <div u-i-material-symbols-arrow-cool-down></div>
        <span></span>
      </button>
      <button
        class="flex items-center justify-center gap-1 op-40 hover:op-100 op-transition"
        data-action="all"
      >
        <div u-i-material-symbols-expand-all></div>
        <span></span>
      </button>
    </div>
  </div>
  <!-- Shortcuts Footer -->
  <footer role="note" aria-label="Keyboard shortcuts">
    <ul
      class="flex flex-wrap items-center gap-4.5 lt-md:hidden
        pt-3 border-t border-[#7d7d7d4d]
        text-xs op-40 select-none"
    >
      <li class="flex items-center gap-1">
        <kbd class="search-kbd-key">
          <div u-i-material-symbols-arrow-upward></div>
        </kbd>
        <kbd class="search-kbd-key">
          <div u-i-material-symbols-arrow-downward></div>
        </kbd>
        <span>Navigate</span>
      </li>
      <li class="flex items-center gap-1">
        <kbd class="search-kbd-key">
          <div u-i-grommet-icons-return></div>
        </kbd>
        <span>Go to Page</span>
      </li>
      <li class="flex items-center gap-1">
        <kbd class="search-kbd-key">esc</kbd>
        <span>Close</span>
      </li>
    </ul>
  </footer>
</search-panel>

<script>
  import { toggleFadeEffect } from '~/utils/misc'

  /* Handle click on search switch to open or close */
  document.addEventListener('astro:page-load', () => {
    const handleToggle = () => {
      toggleFadeEffect('backdrop', true, 'hidden')
      toggleFadeEffect('search-panel', true, 'hidden')
    }

    const searchSwitch = document.getElementById('search-switch')
    searchSwitch?.addEventListener('click', handleToggle)
  })
</script>

<script>
  import { registerSearchPanel } from '~/scripts/search-panel'

  registerSearchPanel()
</script>

{import.meta.env.PROD && hasSearchablePosts && navHighlight &&
  <script is:inline data-astro-rerun define:vars={{scriptUrl: withBasePath('/pagefind/pagefind-highlight.js')}}>
    async function loadPagefindHighlight() {
      try {
        await import(scriptUrl)

        const PagefindHighlight = window.PagefindHighlight
        if (!PagefindHighlight) return null
        const pagefindHighlight = new PagefindHighlight({
          // https://pagefind.app/docs/highlight-config
          highlightParam: "search",
          markContext: "[data-pagefind-body]",
          markOptions: {
            // https://markjs.io/#mark
            className: "pagefind-highlight",
            exclude: ["[data-pagefind-ignore]", "[data-pagefind-ignore] *"],
          },
          addStyles: false,
        });

        window.pagefindHighlight = pagefindHighlight
        return pagefindHighlight
      } catch (_err) {
        window.pagefindHighlightPromise = undefined
        return null
      }
    }

    if (!window.pagefindHighlight && !window.pagefindHighlightPromise) {
      window.pagefindHighlightPromise = loadPagefindHighlight()
    }
  </script>}

{import.meta.env.PROD && hasSearchablePosts && navHighlight &&
  <script>
    if (!window.__pagefindHighlightListenerBound) {
      window.__pagefindHighlightListenerBound = true
      document.addEventListener('astro:page-load', async () => {
        try {
          const search = location.search
          const href = location.href
          const params = new URLSearchParams(search)
          if (!params.has('search')) return

          const highlighter =
            window.pagefindHighlight ?? (await window.pagefindHighlightPromise)
          if (
            !highlighter ||
            location.href !== href ||
            location.search !== search
          ) {
            return
          }

          highlighter.highlight()
        } catch (_err) {
          // Keep page navigation resilient when highlighting fails.
        }
      })
    }
  </script>}
