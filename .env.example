# Copy to .env on the VPS. deploy.sh sets BLOG_IMAGE after verifying the running image.
# For the first deployment, leave this unset and pass the approved GHCR digest to deploy.sh.
# BLOG_IMAGE=ghcr.io/owner/repository@sha256:<64-lowercase-hex>

# Replace this placeholder with the existing reverse-proxy network on your server.
# Real network names and server configuration stay outside the repository.
MINTBLOG_PROXY_NETWORK=REPLACE_WITH_EXISTING_PROXY_NETWORK
