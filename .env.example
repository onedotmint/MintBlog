# Copy to .env on the VPS and replace owner/repository once (use lowercase).
# bootstrap is only a repository hint; deploy.sh resolves a published SHA before pulling.
# After internal health succeeds, deploy.sh saves the running SHA image here automatically.
BLOG_IMAGE=ghcr.io/owner/repository:bootstrap

# Replace this placeholder with the existing reverse-proxy network on your server.
# Real network names and server configuration stay outside the repository.
MINTBLOG_PROXY_NETWORK=REPLACE_WITH_EXISTING_PROXY_NETWORK
